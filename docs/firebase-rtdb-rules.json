{
  "rules": {
    ".read": "auth != null",
    ".write": false,

    "voice": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "quota": {
          "$date": {
            ".validate": "newData.isNumber() && newData.val() <= 4 && (!data.exists() || newData.val() === data.val() + 1)"
          }
        }
      }
    },

    "feed": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || auth.token.email === 'schoudhary11256@gmail.com')",
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "likeCount": { ".write": "auth != null" },
        "commentCount": { ".write": "auth != null" },
        "shareCount": { ".write": "auth != null" }
      }
    },

    "comments": {
      "$postId": {
        ".read": "auth != null",
        "$cid": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || auth.token.email === 'schoudhary11256@gmail.com')",
          ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
        }
      }
    },

    "follows": {
      "$followerUid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $followerUid"
      }
    },
    "followers": {
      "$followeeUid": {
        ".read": "auth != null",
        "$followerUid": {
          ".write": "auth != null && auth.uid === $followerUid"
        }
      }
    },

    "userStats": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "shareStats": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "shareEvents": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$postId": {
          "$eventId": {
            ".write": "auth != null && newData.child('createdAt').isNumber() && (newData.child('channel').val() === 'dm' || newData.child('channel').val() === 'story' || newData.child('channel').val() === 'link' || newData.child('channel').val() === 'replay')"
          }
        }
      }
    },

    "dm": {
      "$thread": {
        ".read": "auth != null && data.child('participants').child(auth.uid).val() === true",
        ".write": "auth != null && $thread.contains(auth.uid) && ((!data.exists() && newData.child('participants').child(auth.uid).val() === true) || data.child('participants').child(auth.uid).val() === true)"
      }
    },

    "mehfil": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },

    "broadcasts": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'schoudhary11256@gmail.com'"
    },

    "broadcastVotes": {
      ".read": "auth != null",
      "$bid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "reports": {
      ".read": "auth != null && auth.token.email === 'schoudhary11256@gmail.com'",
      "$id": {
        ".write": "auth != null"
      }
    },

    "siteConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'schoudhary11256@gmail.com'"
    },

    "admin": {
      ".read": "auth != null",
      "presence": {
        ".write": "auth != null && auth.token.email === 'schoudhary11256@gmail.com'"
      }
    },

    "tickets": {
      ".read": "auth != null && auth.token.email === 'schoudhary11256@gmail.com'",
      "$id": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || auth.token.email === 'schoudhary11256@gmail.com')",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || auth.token.email === 'schoudhary11256@gmail.com')"
      }
    },

    "bookmarks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "hashtags": {
      ".read": true,
      "counts": {
        "$tag": { ".write": "auth != null" }
      },
      "posts": {
        "$tag": {
          "$postId": { ".write": "auth != null" }
        }
      }
    },

    "pollVotes": {
      ".read": "auth != null",
      "$postId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}